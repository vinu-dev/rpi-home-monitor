# REQ: SWR-050, SWR-063; RISK: RISK-001, RISK-018; SEC: SC-019; TEST: TC-044, TC-047
[Unit]
Description=Home Monitor Server
# network.target (not network-online.target): monitor binds to localhost:5000
# and talks to local mediamtx — it does not need internet connectivity at boot.
# network-online.target waits for NetworkManager-wait-online (~60s) and
# systemd-networkd-wait-online (~90s on no-carrier eth0) — causing multi-minute
# startup delays for no benefit.
After=network.target nginx.service mediamtx.service local-fs.target monitor-privileged-helper.service
Wants=mediamtx.service
Requires=monitor-privileged-helper.service

[Service]
Type=notify
NotifyAccess=main
# Flask runs unprivileged. Root-only appliance operations go through
# monitor-privileged-helper.service over a monitor-group Unix socket.
User=monitor
Group=monitor
WorkingDirectory=/opt/monitor
ExecStart=/usr/bin/python3 -m flask --app monitor run --host=127.0.0.1 --port=5000
ExecStartPost=+/usr/bin/home-monitor-ledctl healthy --role server --force --clear-activation
Restart=always
RestartSec=5
WatchdogSec=60
StartLimitIntervalSec=300
StartLimitBurst=5
Environment=PYTHONPATH=/opt/monitor
Environment=FLASK_APP=monitor
Environment=MONITOR_DATA_DIR=/data
Environment=MONITOR_RECORDINGS_DIR=/data/recordings
Environment=MONITOR_LIVE_DIR=/data/live
Environment=MONITOR_CONFIG_DIR=/data/config
Environment=MONITOR_CERTS_DIR=/data/certs
Environment=MONITOR_LOG_DIR=/data/logs
Environment=MONITOR_PRIVILEGED_HELPER_SOCKET=/run/monitor/privileged-helper.sock
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LOG_LEVEL=INFO

# Security: nftables firewall (default DROP, private nets only) + HTTPS
# Note: systemd ProtectSystem/ProtectHome/ProtectKernel* directives create
# private mount namespaces, which prevents USB mounts from being visible
# to NGINX for serving recorded clips. ProtectSystem remains disabled for USB
# storage visibility; root-only actions are delegated to the privileged helper.
NoNewPrivileges=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
PrivateTmp=true

[Install]
WantedBy=multi-user.target
